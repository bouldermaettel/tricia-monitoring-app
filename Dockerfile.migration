FROM python:3.11-slim

RUN apt-get update \
    && apt-get install --no-install-recommends -y postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /migration
COPY scripts/clone_prod_to_dev.py /migration/clone_prod_to_dev.py

RUN pip install --no-cache-dir \
    "SQLAlchemy>=2.0.31" \
    "psycopg[binary]>=3.2.1"

ENTRYPOINT ["python", "/migration/clone_prod_to_dev.py"]
